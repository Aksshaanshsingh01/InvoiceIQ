# InvoiceIQ environment configuration

# Local development:
# Path to your Firebase Admin SDK service-account JSON.
# Leave empty when running in Google Cloud with Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT=invoiceiq-643c6-firebase-adminsdk-fbsvc-a6385b72c4.json

# FastAPI URL used by the NiceGUI frontend.
INVOICEIQ_API_URL=http://127.0.0.1:8000

# NiceGUI server port.
INVOICEIQ_FRONTEND_PORT=8080

# Maximum PDF upload size in bytes.
INVOICEIQ_MAX_UPLOAD_SIZE=10485760
